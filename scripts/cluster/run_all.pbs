#!/bin/bash
#PBS -S /bin/bash
#PBS -l walltime=120:00:00
#PBS -l nodes=1:ppn=96
#PBS -N MFSindy_all
#PBS -j oe

# Every case, Parts I and II, on one node: qsub scripts/cluster/run_all.pbs
# Some cases only: qsub -v STAGES="vorticity isothermal_flow" scripts/cluster/run_all.pbs
# One part of the isothermal flow: STAGES="isothermal_flow2" runs Part II alone, in full.
#
# In order: the ODEs and Burgers (full Monte Carlo, each config's own number of
# runs, 100), then the vorticity flow and the isothermal flow, each first as a
# quick pass of QUICK_RUNS runs for an early look and then in full. A quick
# pass's tables and logs are copied to results/quick_<job id>/<case>/ before
# the full pass overwrites them. QUICK_RUNS=0 skips the quick passes. The
# isothermal flow, the slowest case and the one the vorticity flow may
# replace, comes last, so the job can be stopped there.
#
# Each case gets as many workers (Monte Carlo runs in parallel) as the node's
# memory allows, capped at the cores: the peak memory of one worker was measured
# with scratch/mem_probe.py and is listed below. The number of workers does not
# change the results (runs are seeded by index). Per-case logs are written to
# examples/<case>/results/main<part>.log, this job's own to $LOG.

ROOT=/u/zacchei/WLS-Sindy
LOG="$ROOT/scripts/cluster/run_all_${PBS_JOBID:-local}.log"
cd "$ROOT" || exit 1

source /u/zacchei/miniconda3/etc/profile.d/conda.sh
conda activate sindy

# One BLAS thread per process: the parallelism is across runs, and 48 workers
# each starting a BLAS thread per core would oversubscribe the node many times over.
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export PYTHONUNBUFFERED=1

# The whole node is requested (96 logical cores) but at most 48 workers run:
# the physical cores, as a second hyperthread adds little to numerical work.
CORES=48
MEM_GB=$(awk '/MemAvailable/ {printf "%d", $2 / 1048576}' /proc/meminfo)

# Workers for a case whose worker peaks at $1 GB: 80% of the free memory, at
# most one per core and at most the 100 runs.
workers() {
    awk -v mem="$MEM_GB" -v gb="$1" -v cores="$CORES" 'BEGIN {
        n = int(0.8 * mem / gb); if (n > cores) n = cores; if (n > 100) n = 100
        if (n < 1) n = 1; print n }'
}

QUICK_RUNS=10

# Peak GB of one worker, measured on one run of each case.
ODE_GB=0.5
BURGERS_GB=2.5   # Part II 2.0, Part I 0.4
NS1_GB=8         # windows 2.5 on 128 x 128: not yet measured, 2.9 at window 1.25 (scripts/cluster/check_ns.py memory)
NS2_GB=12        # windows 2.5 on 128 x 128: not yet measured, 4.6 at window 1.25
VORT1_GB=6       # vorticity flow, windows 2.5 on 128 x 128: not yet measured, 9 monomials against 19
VORT2_GB=8

{
    echo "=========================================="
    echo "Start time: $(date)"
    echo "PBS_JOBID = ${PBS_JOBID}"
    echo "Node: $(cat "${PBS_NODEFILE:-/dev/null}" 2>/dev/null | sort -u | tr '\n' ' ')"
    echo "Cores: $CORES, free memory: ${MEM_GB} GB"
    echo "Workers: ODEs $(workers $ODE_GB), burgers $(workers $BURGERS_GB), isothermal_flow $(workers $NS1_GB) (Part I), $(workers $NS2_GB) (Part II), vorticity $(workers $VORT1_GB) / $(workers $VORT2_GB)"
    echo "=========================================="
} > "$LOG"

status=0
QUICK_DIR="$ROOT/results/quick_${PBS_JOBID:-local}"

run() { scripts/run_all.sh "$@" >> "$LOG" 2>&1 || status=1; }

# Parts I and II of one flow case, with their own worker counts; extra
# arguments (--runs N) go to both.
run_flow() {
    local case=$1 gb1=$2 gb2=$3; shift 3
    run --cases "$case" --parts 1 --jobs "$(workers "$gb1")" "$@"
    run --cases "$case" --parts 2 --jobs "$(workers "$gb2")" "$@"
}

# A quick pass of a flow case, its tables kept, then the full one.
quick_then_full() {
    local case=$1 gb1=$2 gb2=$3
    if (( QUICK_RUNS > 0 )); then
        echo "=== $case: quick pass, $QUICK_RUNS runs ($(date)) ===" >> "$LOG"
        run_flow "$case" "$gb1" "$gb2" --runs "$QUICK_RUNS"
        mkdir -p "$QUICK_DIR/$case"
        cp examples/"$case"/results/*_errors.csv examples/"$case"/results/*_errors_selection.pkl \
           examples/"$case"/results/main*.log "$QUICK_DIR/$case/" 2>/dev/null
        echo "=== $case: quick pass saved to $QUICK_DIR/$case ($(date)) ===" >> "$LOG"
    fi
    echo "=== $case: full pass ($(date)) ===" >> "$LOG"
    run_flow "$case" "$gb1" "$gb2"
}

# Which cases to run, in this order; e.g. qsub -v STAGES="vorticity" for one case.
STAGES=${STAGES:-"odes burgers vorticity isothermal_flow"}
echo "Stages: $STAGES" >> "$LOG"
for stage in $STAGES; do
    case $stage in
        odes)            run --odes --jobs "$(workers $ODE_GB)" ;;
        burgers)         run --cases burgers --jobs "$(workers $BURGERS_GB)" ;;
        vorticity)       quick_then_full vorticity "$VORT1_GB" "$VORT2_GB" ;;
        isothermal_flow) quick_then_full isothermal_flow "$NS1_GB" "$NS2_GB" ;;
        isothermal_flow2) run --cases isothermal_flow --parts 2 --jobs "$(workers $NS2_GB)" ;;   # Part II alone, full
        *)               echo "!! unknown stage $stage" >> "$LOG"; status=1 ;;
    esac
done

echo "End time: $(date)" >> "$LOG"
exit $status
