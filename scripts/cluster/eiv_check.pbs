#!/bin/bash
#PBS -S /bin/bash
#PBS -l walltime=120:00:00
#PBS -l nodes=1:ppn=96
#PBS -N MFSindy_eiv
#PBS -j oe

# Validation of the plug-in EIV score (scripts/cluster/eiv_check.py): every run of
# every case, Parts I and II, at every support. Writes results/eiv_check/ only;
# the paper's results in examples/<case>/results are not touched.
#   qsub scripts/cluster/eiv_check.pbs
#   qsub -v STAGES="isothermal_flow" scripts/cluster/eiv_check.pbs
#   qsub -v STAGES="isothermal_flow",RUNS=20 scripts/cluster/eiv_check.pbs
# Finished runs are skipped, so a stopped job can be resubmitted as is.

ROOT=/u/zacchei/WLS-Sindy
LOG="$ROOT/scripts/cluster/eiv_check_${PBS_JOBID:-local}.log"
cd "$ROOT" || exit 1

source /u/zacchei/miniconda3/etc/profile.d/conda.sh
conda activate sindy

export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export PYTHONUNBUFFERED=1

CORES=48
MEM_GB=$(awk '/MemAvailable/ {printf "%d", $2 / 1048576}' /proc/meminfo)
workers() {
    awk -v mem="$MEM_GB" -v gb="$1" -v cores="$CORES" 'BEGIN {
        n = int(0.8 * mem / gb); if (n > cores) n = cores; if (n > 100) n = 100
        if (n < 1) n = 1; print n }'
}

# Peak GB of one worker: run_all.pbs's figures, raised for the perturbed systems
# the check keeps beside the fit (one set per rung, about 2x the fit's own).
ODE_GB=1
BURGERS_GB=4
VORT1_GB=10
VORT2_GB=12
NS1_GB=12
NS2_GB=16
DRAWS=${DRAWS:-4}
RUNS=${RUNS:-100}

check() { python scripts/cluster/eiv_check.py --draws "$DRAWS" --runs "$RUNS" "$@" >> "$LOG" 2>&1 || status=1; }

status=0
STAGES=${STAGES:-"odes burgers vorticity isothermal_flow"}
{
    echo "Start: $(date)  job ${PBS_JOBID}  free memory ${MEM_GB} GB  stages: $STAGES  draws: $DRAWS"
} > "$LOG"
for stage in $STAGES; do
    echo "=== $stage ($(date))" >> "$LOG"
    case $stage in
        odes)            check --cases lorenz hopf pendulum --jobs "$(workers $ODE_GB)" ;;
        burgers)         check --cases burgers --jobs "$(workers $BURGERS_GB)" ;;
        vorticity)       check --cases vorticity --parts 1 --jobs "$(workers $VORT1_GB)"
                         check --cases vorticity --parts 2 --jobs "$(workers $VORT2_GB)" ;;
        isothermal_flow) check --cases isothermal_flow --parts 1 --jobs "$(workers $NS1_GB)"
                         check --cases isothermal_flow --parts 2 --jobs "$(workers $NS2_GB)" ;;
        *)               echo "!! unknown stage $stage" >> "$LOG"; status=1 ;;
    esac
done
python scripts/cluster/eiv_check.py --summary >> "$LOG" 2>&1
echo "End: $(date)" >> "$LOG"
exit $status
